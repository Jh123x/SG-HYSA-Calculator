                    y="20"
                  />
                </clippath>
              </svg>
            </div>
          </div>
        </div>
      </div>
      <span
        class="MuiTypography-root MuiTypography-caption css-11nzu0x-MuiTypography-root"
      >
        * The “updated at” date reflects when this calculator was updated, which may differ from the date the bank published the change.
      </span>
    </div>
  </div>
</DocumentFragment>
`;
